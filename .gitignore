# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.out
coverage.html

# Go workspace file
go.work
go.work.sum

# Dependency directory (we use modules; vendored deps are not committed)
vendor/

# Build artifacts
bin/
dist/
# Binaries produced by `go build ./cmd/...` at the module root
/toise
/toise-demo
/toise-probe
# Compiled binary of the throwaway Pebble PoC (scratch module)
/scratch/pebble-poc/pebble-poc

# Local data directories (Pebble event log written by toise-server / demos)
/toise-data/
/toise-demo-data/
/live-data/

# Editors / IDEs
.idea/
.vscode/
*.swp
*.swo

# Local environment
.env
.env.local
