# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{md,markdown}]
indent_style = space
indent_size = 2
# Trailing whitespace can be meaningful in Markdown (hard line breaks).
trim_trailing_whitespace = false

[*.{json,proto}]
indent_style = space
indent_size = 2
